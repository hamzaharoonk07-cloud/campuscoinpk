# Leave MONGO_URI empty locally to use the embedded MongoDB (data in server/data/db).
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: password-reset and report-sharing email. Without these the reset link
# is returned in the API response instead (handy for the demo video).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus Coin <no-reply@campuscoin.app>"

# Optional: lets the AI assistant use Claude for narrative insights.
# Without it the app falls back to its own built-in statistical engine.
ANTHROPIC_API_KEY=

# Protects the Vercel cron endpoint.
CRON_SECRET=

# Web Push (budget alerts + daily reminder). Generate a pair once with
# `npx web-push generate-vapid-keys`. Without these, push is simply disabled.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com
