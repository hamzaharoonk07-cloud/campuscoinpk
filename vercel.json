{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "MONGOMS_DISABLE_POSTINSTALL=1 npm install --prefix server && npm install --prefix client",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 30, "includeFiles": "server/src/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!assets/|favicon|manifest|sw\\.js).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 3 * * *" }]
}
